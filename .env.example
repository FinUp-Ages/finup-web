# URL base da API do finup-backend.
# Tudo com prefixo VITE_ vai para o bundle e e PUBLICO. Nunca coloque segredo aqui.
VITE_API_BASE_URL=http://localhost:8080

# Com "true", as telas usam dados simulados (mocks em features/<nome>/api/) em vez do backend.
VITE_USE_MOCKS=true

# AWS Cognito: User Pool do FinUp e app client do PAINEL (nao o "FinUp" do app mobile).
# Nao sao segredo: o app client do painel nao tem client secret. Os mesmos valores estao no
# finup-backend: regiao = prefixo do COGNITO_USER_POOL_ID (us-east-2_... -> us-east-2) e
# client ID = COGNITO_ADMIN_CLIENT_ID. O app client precisa do fluxo ALLOW_USER_AUTH.
VITE_COGNITO_REGION=<regiao-do-pool>
VITE_COGNITO_CLIENT_ID=<client-id-do-app-client-do-painel>
